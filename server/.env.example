PORT=4000

# Postgres. Neon (or any hosted Postgres) — must include sslmode=require.
DATABASE_URL=postgresql://user:password@host.neon.tech/meetup?sslmode=require

# Redis. Optional and unused — LiveKit Cloud carries presence and chat.
# Set it only if a Redis is actually reachable; an unset value is reported
# as not_configured rather than failing the health check.
# REDIS_URL=redis://localhost:6379

# LiveKit Cloud project credentials (Settings -> Keys).
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Signs short-lived guest meeting tokens (any long random string).
AUTH_SECRET=
